{
  "name": "fastify-clean-di",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev": "concurrently -n API,WORKER -c blue,green \"npm run dev:api\" \"npm run dev:worker\"",
    "build": "tsc",
    "build:api": "tsc --project tsconfig.json",
    "build:worker": "tsc --project tsconfig.json",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "start": "concurrently -n API,WORKER -c blue,green \"npm run start:api\" \"npm run start:worker\""
  },
  "dependencies": {
    "@fastify/compress": "^7.0.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.0.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.16.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}